# Base de données
POSTGRES_DB=synclearn
POSTGRES_USER=synclearn
POSTGRES_PASSWORD=synclearn_dev_password
DATABASE_URL=postgresql+psycopg://synclearn:synclearn_dev_password@db:5432/synclearn

# Stockage des fichiers
MINIO_ROOT_USER=synclearn_minio
MINIO_ROOT_PASSWORD=synclearn_minio_dev_password
MINIO_BUCKET=synclearn
MINIO_PUBLIC_ENDPOINT=localhost:9000
SEED_DEMO_DATA=true

# API et sessions
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=synclearn-local-only-change-before-deployment
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false

# Interface web
VITE_API_URL=http://localhost:8000/api/v1
